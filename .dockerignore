# ===== .dockerignore =====
# Things that should NEVER end up inside the production image.

# Git / IDE
.git
.github
.gitignore
.idea
.vscode

# Local env files (only .env.example is allowed)
.env
*.env.local
*.env.development
*.env.test
backend/.env
frontend/.env
frontend/.env.local

# Python
**/__pycache__
**/*.pyc
**/.pytest_cache
**/venv
**/.venv

# Node
**/node_modules
**/build
**/.next

# Logs / OS
**/*.log
.DS_Store
Thumbs.db

# Tests / agents (not needed in prod)
test_reports/
db_backup/
**/test_*.py
**/*_test.py

# Memory / docs the agent uses
memory/
PRD.md
ROADMAP.md
CHANGELOG.md
design_guidelines.md
test_result.md

# Backups (we mount this dir into the mongo container instead)
deploy/backup/
